---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getIslands } from '../lib/islands.js';
import { arcPath } from '../stores/navigationStore.js';

const islands = await getIslands();
---

<BaseLayout>
  <!-- Soft scrim so the headline stays legible over a busy sea. -->
  <div
    class="pointer-events-none fixed bottom-0 left-0 h-[60dvh] w-full max-w-4xl bg-[radial-gradient(ellipse_at_bottom_left,rgba(7,18,31,0.62),transparent_68%)]"
    aria-hidden="true"
  >
  </div>

  <section
    class="pointer-events-none fixed inset-x-[var(--hud-gutter)] bottom-[var(--hud-gutter)] max-w-xl lg:bottom-10 lg:left-10"
  >
    <p class="eyebrow animate-rise-in text-ink-stroke">Grand Line · Paradise to the New World</p>
    <h1
      class="animate-rise-in mt-2 font-display text-[2.6rem] leading-[0.95] text-foam text-ink-stroke [animation-delay:90ms] sm:text-6xl lg:text-7xl"
    >
      Follow the needle.
    </h1>
    <p
      class="animate-rise-in mt-3 max-w-md text-[1.02rem] leading-snug text-foam text-ink-stroke [animation-delay:180ms] sm:text-lg"
    >
      No compass works on this sea.{' '}
      <span class="pointer-coarse:hidden">Hover an island to pull the Log Pose toward it, then select it to set course.</span>
      <span class="pointer-fine:hidden">Tap an island to lock the Log Pose and set course. Drag to look around.</span>
    </p>

    <!-- Crawlable route list; the 3D beacons and the quick-jump drawer mirror it. -->
    <ol class="pointer-events-auto animate-rise-in mt-4 hidden flex-wrap gap-1.5 [animation-delay:270ms] sm:flex" aria-label="Islands on the route">
      {
        islands.map((island) => (
          <li>
            <a href={arcPath(island.slug)} data-island-link={island.slug} class="hud-button px-3! py-1.5!">
              <span class="text-brass-light">{String(island.arcOrder).padStart(2, '0')}</span>
              {island.title}
            </a>
          </li>
        ))
      }
    </ol>

    <p class="mt-4 hidden font-mono text-[0.6rem] uppercase tracking-[0.14em] text-foam/70 text-ink-stroke sm:block">
      Unofficial fan project · One Piece © Eiichiro Oda / Shueisha, Toei Animation
    </p>
  </section>
</BaseLayout>
